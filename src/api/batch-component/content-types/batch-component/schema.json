{
  "kind": "collectionType",
  "collectionName": "batch_components",
  "info": {
    "singularName": "batch-component",
    "pluralName": "batch-components",
    "displayName": "BatchComponent"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "batch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::batch.batch",
      "inversedBy": "batch_components"
    },
    "ingredient": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::ingredient.ingredient"
    },
    "current_status": {
      "type": "enumeration",
      "default": "TODO",
      "enum": [
        "TODO",
        "FINISHED"
      ]
    },
    "quantity": {
      "type": "decimal",
      "required": true,
      "unique": false
    },
    "tolerance": {
      "type": "decimal",
      "required": true
    },
    "lot_number": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32
    },
    "finished_date": {
      "type": "datetime"
    },
    "actual_quantity": {
      "type": "decimal",
      "default": 0
    }
  }
}
