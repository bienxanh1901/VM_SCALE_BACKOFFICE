{
  "kind": "collectionType",
  "collectionName": "batches",
  "info": {
    "singularName": "batch",
    "pluralName": "batches",
    "displayName": "Batch"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "scheduled_job": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::scheduled-job.scheduled-job",
      "inversedBy": "batches"
    },
    "code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16,
      "required": true
    },
    "current_status": {
      "type": "enumeration",
      "required": false,
      "default": "TODO",
      "enum": [
        "TODO",
        "INPROGRESS",
        "FINISHED"
      ]
    },
    "finished_date": {
      "type": "datetime"
    },
    "batch_components": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::batch-component.batch-component",
      "mappedBy": "batch"
    }
  }
}
