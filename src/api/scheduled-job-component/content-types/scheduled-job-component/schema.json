{
  "kind": "collectionType",
  "collectionName": "scheduled_job_components",
  "info": {
    "singularName": "scheduled-job-component",
    "pluralName": "scheduled-job-components",
    "displayName": "ScheduledJobComponent"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "scheduled_job": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::scheduled-job.scheduled-job",
      "inversedBy": "scheduled_job_components"
    },
    "ingredient": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::ingredient.ingredient"
    },
    "quantity": {
      "type": "decimal",
      "required": true
    },
    "tolerance": {
      "type": "decimal",
      "default": 0
    },
    "lot_number": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "required": true
    },
    "batch_size": {
      "type": "decimal",
      "required": true
    },
    "mix_order": {
      "type": "integer",
      "required": true
    },
    "mix_area": {
      "type": "string",
      "required": true
    },
    "expired_after_hour": {
      "type": "integer",
      "required": true
    }
  }
}
